#  Tegne-hjelper GUI
def rounded_rect(canvas, x1, y1, x2, y2, r=20, **kwargs):
    points = [
        x1+r, y1,
        x1+r, y1,
        x2-r, y1,
        x2-r, y1,
        x2, y1,
        x2, y1+r,
        x2, y1+r,
        x2, y2-r,
        x2, y2-r,
        x2, y2,
        x2-r, y2,
        x2-r, y2,
        x1+r, y2,
        x1+r, y2,
        x1, y2,
        x1, y2-r,
        x1, y2-r,
        x1, y1+r,
        x1, y1+r,
        x1, y1
    ]
    return canvas.create_polygon(points, smooth=True, **kwargs)


#  Farge-funksjoner for tangenter
def press_key(midi_note):
    if midi_note in midi_note_to_key:
        key_data = midi_note_to_key[midi_note]
        canvas.itemconfig(key_data["id"], fill=key_data["pressed_color"])

def release_key(midi_note):
    if midi_note in midi_note_to_key:
        key_data = midi_note_to_key[midi_note]
        canvas.itemconfig(key_data["id"], fill=key_data["normal_color"])


#  Callbacks for pads
def on_pad_click(event, pad_num):
    debug_print(f"Pad {pad_num} pressed")


#  Callbacks for tangenter
def on_key_press(event, midi_note):
    debug_print(f"GUI key pressed: {midi_note}")
    press_key(midi_note)
    esp.note_on(midi_note, 100)

def on_key_release(event, midi_note):
    debug_print(f"GUI key released: {midi_note}")
    release_key(midi_note)
    esp.note_off(midi_note)


#  Callback for valg av bolgeform
def select_wave(wave):
    global current_wave
    current_wave = wave
    debug_print(f"Waveform set to {WAVE_NAMES[wave]}")
    esp.param(PARAM_WAVEFORM, wave)


#  MIDI UART-handtering
def handle_midi_message(status, data1, data2):
    """
    Tolker en komplett 3-byte MIDI-melding.
    status = statusbyte, f.eks. 0x90 for note_on
    data1 = note/waveform
    data2 = velocity
    """

    message_type = status & 0xF0
    channel = status & 0x0F

    # Note On
    if message_type == 0x90 and data2 > 0:
        note = data1
        velocity = data2

        debug_print(f"NOTE ON  note={note}, velocity={velocity}, channel={channel + 1}")

        esp.note_on(note, velocity)
        root.after(0, release_key, note)

    # Note Off
    elif message_type == 0x80 or (message_type == 0x90 and data2 == 0):
        note = data1

        debug_print(f"NOTE OFF note={note}, channel={channel + 1}")

        esp.note_off(note)
        root.after(0, release_key, note)


def midi_listener():
    """
    Leser MIDI direkte fra Raspberry Pi UART.
    Brukes nar MIDI DIN gar via optocoupler inn pa RPI RX.
    """

    if serial is None:
        debug_print("pyserial is not installed. UART MIDI cannot be used on this machine.")
        return

    try:
        midi_serial = serial.Serial(
            port=MIDI_UART_PORT,
            baudrate=MIDI_BAUDRATE,
            bytesize=serial.EIGHTBITS,
            parity=serial.PARITY_NONE,
            stopbits=serial.STOPBITS_ONE,
            timeout=0.01
        )

        debug_print(f"Listening for MIDI on {MIDI_UART_PORT} at {MIDI_BAUDRATE} baud")

    except serial.SerialException as e:
        debug_print("Could not open MIDI UART:", e)
        return

    running_status = None
    data_bytes = []

    while True:
        raw_byte = midi_serial.read(1)

        if not raw_byte:
            continue
        byte = raw_byte[0]

        # System Real-Time (0xF8-0xFF): kan komme når som helst,
        # avbryter IKKE running status, har ingen databytes. Ignorer.
        if byte >= 0xF8:
            continue

        # System Common (0xF0-0xF7): nullstiller running status
        if 0xF0 <= byte <= 0xF7:
            running_status = None
            data_bytes = []
            continue

        # Kanal-statusbyte: 0x80 - 0xEF (note on/off, CC, osv.)
        if byte & 0x80:
            running_status = byte
            data_bytes = []
            continue

        # Databyte: 0x00 - 0x7F
        if running_status is None:
            continue

        data_bytes.append(byte)
        message_type = running_status & 0xF0

        if message_type in (0x80, 0x90) and len(data_bytes) >= 2:
            handle_midi_message(running_status, data_bytes[0], data_bytes[1])
            data_bytes = []   # running_status beholdes for neste melding



