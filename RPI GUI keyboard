# 1. IMPORTS OG AVHENGIGHETSHANDTERING


import tkinter as tk
import threading


DEBUG = True

def debug_print(*args):
    if DEBUG:
        print(*args)


# pyserial er kun tilgjengelig på maskiner med UART-støtte.
try:
    import serial
except ImportError:
    serial = None

# spidev er kun tilgjengelig på Raspberry Pi. Uten den kjører
# programmet med en "fake" SPI som kun skriver ut meldinger.
try:
    import spidev
    SPI_AVAILABLE = True
except ImportError:
    spidev = None
    SPI_AVAILABLE = False




# 2. KONSTANTER

#  SPI-kommandoer til ESP32
CMD_NOTE_ON = 1   # Command for note on
CMD_NOTE_OFF = 2  # Command for note off
CMD_PARAM = 3     # Command for parameter change

#  Bolgeform-definisjoner
WAVE_SIN = 100
WAVE_SAW = 101
WAVE_SQUARE = 102
PARAM_WAVEFORM = 0

WAVE_NAMES = {
    WAVE_SIN: "SINE",
    WAVE_SAW: "SAW",
    WAVE_SQUARE: "SQUARE"
}

#  MIDI UART
MIDI_UART_PORT = "/dev/serial0"
MIDI_BAUDRATE = 31250



# 3. KLASSER


class ESPTransport:
    """Handterer SPI-kommunikasjon mot ESP32.

    Faller automatisk tilbake til en "fake" SPI dersom spidev
    ikke er tilgjengelig, eller SPI-porten ikke kan åpnes.
    """
    def __init__(self, use_fake=False):
        self.use_fake = use_fake or not SPI_AVAILABLE
        self.spi = None
        self.lock = threading.Lock()

        if self.use_fake:
            debug_print("Running with FAKE SPI. Messages will only be printed.")
            return

        try:
            self.spi = spidev.SpiDev()
            self.spi.open(0, 1)
            self.spi.max_speed_hz = 2_000_000
            self.spi.mode = 0
            print("SPI connected to ESP32")
        except Exception as e:
            print("Could not open SPI. Falling back to FAKE SPI.")
            print("Reason:", e)
            self.use_fake = True
            self.spi = None

    def send_packet(self, packet):
        with self.lock:
            if self.use_fake:
                debug_print("FAKE SPI SEND:", packet)
                return

            try:
                # Catch the response from the ESP32
                response = self.spi.xfer2(packet)

                # Format the response as Hex for easy reading
                hex_response = [hex(b) for b in response]
                debug_print(f"--> SPI SENT: {packet} | ESP32 RETURNED: {hex_response}")

            except Exception as e:
                debug_print("SPI error:", e)

    def note_on(self, note, velocity):
        note = int(note) & 0x7F
        velocity = int(velocity) & 0x7F
        checksum = (CMD_NOTE_ON + note + velocity) & 0xFF
        self.send_packet([CMD_NOTE_ON, note, velocity, checksum])

    def note_off(self, note):
        note = int(note) & 0x7F
        checksum = (CMD_NOTE_OFF + note) & 0xFF
        self.send_packet([CMD_NOTE_OFF, note, 0, checksum])

    def param(self, param_id, value):
        param_id = int(param_id) & 0x7F
        value = int(value) & 0xFF
        checksum = (CMD_PARAM + param_id + value) & 0xFF
        self.send_packet([CMD_PARAM, param_id, value, checksum])



