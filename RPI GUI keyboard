#  Svarte tangenter
# monster per oktav: C#, D#, (ingen mellom E-F), F#, G#, A#, (ingen mellom B-C)
black_pattern = [
    (0, "C#", 49),
    (1, "D#", 51),
    (3, "F#", 54),
    (4, "G#", 56),
    (5, "A#", 58)
]
# posisjoner mellom hvite keys i en 7-tonersgruppe

black_key_width = 16
black_key_height = 75

for octave in range(3):
    base_index = octave * 7

    for offset, note_name, midi_note in black_pattern:
        white_index = base_index + offset
        full_midi_note = midi_note + octave * 12

        if white_index + 1 >= len(white_notes):
            continue

        x1 = white_key_x_start + (white_index + 1) * white_key_width - black_key_width / 2
        y1 = white_key_y
        x2 = x1 + black_key_width
        y2 = y1 + black_key_height

        black_key = canvas.create_rectangle(
